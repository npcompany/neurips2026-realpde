"""RealPDE Track 1 submission: {RUN_NAME} ({MODEL_NAME}{BOUNDS_SUFFIX}).

GENERATED by `python -m rpde_t1.submit` -- do not edit in place; edit
src/rpde_t1/submit/model_submission.py.tmpl and rebuild.

Unlike the baseline template, this one does no inference work of its own. It loads
our checkpoint and hands off to `rpde_t1.models.predictor.make_predict`, which is the
same closure training and local scoring use. That is deliberate: a submission that
re-implements normalisation is a submission that can silently disagree with the
numbers we validated against.

The bundled `rpde_t1/` is the inference subset only -- `features`, `geometry` and
`models`. `data/`, `train/`, `score/` are left out because their imports reach h5py,
which the evaluation container does not ship.

Model construction and checkpoint loading happen at import time, outside the region
the platform times, so the `time_score` sees inference only.
"""

from __future__ import annotations

import os
import sys

import numpy as np

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

# Only matters when COMPILE_MODE is set, but harmless otherwise, so it is forced
# unconditionally and before `import torch` (the only point inductor reads it). Inductor's
# parallel-compile worker pool calls ProcessPoolExecutor at first compile; the platform runs
# each participant in a DAEMONIC subprocess, where that raises `AssertionError: daemonic
# processes are not allowed to have children` and the bundle fails ingestion at import.
# FINDINGS 76c identifies this as the likely real cause of Track 1's "compile is 2-for-2
# against us" -- a crash, not a regression. Forced (not setdefault): a platform value > 1
# would reintroduce the crash, so 1 is always what we want.
os.environ["TORCHINDUCTOR_COMPILE_THREADS"] = "1"

import torch  # noqa: E402

from rpde_t1.features import parse_flow_channels  # noqa: E402
from rpde_t1.geometry import parse_geom_channels, warm_geometry_tables  # noqa: E402
from rpde_t1.models.factory import load_for_inference  # noqa: E402
from rpde_t1.models.predictor import DEFAULT_SPIN_S, make_predict, warm_up_predict  # noqa: E402

_CKPT_PATH = os.path.join(_HERE, "{CKPT_NAME}")

_BATCH = {BATCH}

# Whether to emit lower/upper interval bounds for the SPS subscore. This is a baked-in
# constant, not a runtime decision: the scorer discards *all* bounds unless every
# predict() call in the run returns them, and each call may run in a fresh subprocess.
# A constant is the only way to be certain the choice cannot vary between calls.
RETURN_BOUNDS = {RETURN_BOUNDS}

# Constant physical half-width forced under the head's own band, as a floor. SPS credit
# is zero wherever the target escapes the interval, so a collapsed band scores worse
# than a merely wide one. 0.0 disables it.
BOUND_FLOOR = {BOUND_FLOOR}

# Global multiplier on the head's half-widths, fitted against the official scorer on one
# split and reported on another (`python -m rpde_t1.train width-calib`). 1.0 ships the
# head's own widths. Not free tuning: heads trained by this recipe come out ~40% too wide
# and 0.60 is fitted independently on U-Net, FNO and CNO, so it corrects the training
# procedure rather than this backbone. Only `sps_score` can move -- the prediction is
# untouched, so the other four subscores are bit-identical.
BOUND_SCALE = {BOUND_SCALE}

# Fitted width rule, bundled as a json table beside the weights when one was requested at
# build time; empty otherwise and this whole path is off. It is the generalisation of
# BOUND_SCALE -- a multiplier per bin of the head's own predicted log-rho, per channel and
# per lead -- and the two are mutually exclusive by construction: `make_predict` raises
# rather than composing them, since two calibrations of the same width would multiply.
# Only meaningful on a head whose scale is a calibrated log-error regression; on a
# width-trained head the binned table is a net loss.
WIDTH_RULE_NAME = "{WIDTH_RULE_NAME}"

# Per-lead persistence anchor, `anchor + a_t * (pred - anchor)` with the anchor being the last
# observed frame. Closed form, no hyperparameters, and it improves all four scored axes at once
# on this backbone (+0.087 sps, +0.063 tke, +0.006 rel_l2, +0.010 mvpe) for +0.19 ms/window.
#
# Restricted to the first 3 leads deliberately. Past the crossover the fitted weights are noise
# within ~2% of 1, and that noise is one-sided: shrinking toward the anchor shrinks toward a
# field constant in TIME, so any a_t < 1 removes temporal variance and `tke_score` scores
# exactly that. Pinning leads 4+ to 1 removes the leak instead of bounding it.
#
# IT CHANGES THE PREDICTION, so WIDTH_RULE_NAME must be the rule refitted against the *anchored*
# error field -- an unanchored rule is calibrated to a field this build no longer produces.
LEAD_ANCHOR_NAME = "{LEAD_ANCHOR_NAME}"

# Forward precision. "fp32" is the reference; "bf16"/"fp16" run the model under
# torch.autocast, which on the evaluation A800 (A100 silicon) unlocks tensor cores that fp32
# leaves idle -- 312 TFLOPS against 19.5. bf16 over fp16 for its fp32-sized exponent, which
# removes the overflow risk in the attention logits. Baked in, like RETURN_BOUNDS: the
# choice must not vary between calls. A reduced dtype CHANGES the predictions, so any value
# other than "fp32" here was re-scored locally before this bundle was built.
PRECISION = "{PRECISION}"

# PAD_BATCHES repeats the final sample so every forward sees exactly _BATCH rows whatever N the
# platform passes, and slices the padding off after.
#
# **Ship it False, and it is why two submissions were lost** (FINDINGS 49). The platform does
# NOT hand us N=_BATCH; it calls predict() with a small N many times over, and padding each of
# those up to 210 rows multiplies the compute per scored sample. Measured on the two zips at
# the same batch sizes, steady state:
#
#   |  N  | pad=True (day 19, board 27.5 ms/sample) | pad=False (`stf_sps_b210`, board 5.20) |
#   | 210 |  4.82 ms/sample                          |  4.79 ms/sample                        |
#   | 105 |  8.29                                    |  4.78                                  |
#   |  37 | 20.96                                    |  4.80                                  |
#
# Padding existed to serve `torch.compile`'s CUDA graphs, which raise on a second input shape,
# and to amortise `cudnn.benchmark`'s per-shape autotune. **`torch.compile` is now gone** -- it
# is 2-for-2 against us and both of its losses were really this -- so padding has no remaining
# purpose and `cudnn.benchmark` (which only padding could enable) is off with it.
PAD_BATCHES = {PAD_BATCHES}

# Geometry planes appended to the input, copied from the checkpoint's own config by the
# packager. The backbone's first layer was widened for exactly these at training time, so
# this is not a choice made here -- an empty string is the plain three-channel input.
GEOM_CHANNELS = parse_geom_channels("{GEOM_CHANNELS}")

# Planes derived from the observed window (vorticity, fluctuating enstrophy, input TKE),
# copied from the checkpoint's own config for the same reason and with the same consequence
# if it is wrong: the stem was widened for exactly these. Computed by `features.py`, which
# the bundle already ships and which imports numpy and nothing else.
FLOW_CHANNELS = parse_flow_channels("{FLOW_CHANNELS}")

# Second-moment (TKE-map) correction. The head file is bundled only when one was
# requested at build time; TKE_HEAD_NAME is empty otherwise and this whole path is off.
#
# TKE_SHRINK mixes the head with the closed-form geometric blend it generalises, and it
# is NOT free tuning: measured on val_extrap, the blend alone is +2.75 tke, the head
# alone +1.78, and the mixture +4.06. An unshrunk head is worse than the free blend at
# the ends of the Reynolds ladder, which is the regime the private test resembles.
TKE_HEAD_NAME = "{TKE_HEAD_NAME}"
TKE_BLEND = {TKE_BLEND}
TKE_SHRINK = {TKE_SHRINK}

# Interval-centre shrink (FINDINGS 196i). The interval head reads, and the width rule centres
# on, `m + c * (pred - m)` -- m the window's u/v time mean -- while the REPORTED prediction is
# the backbone's own field, so only `sps_score` can move. Post-hoc and time-free. The bundled
# head and width rule were fitted on the same shrunk field (scripts/sps/shrink_cache.py then
# sps_apply.py on the `_c<c>` tag); with a head fitted on the raw field this constant must be
# 1.0, which is exactly the previous behaviour.
CENTRE_SHRINK = {CENTRE_SHRINK}

# torch.compile mode for the forward, empty string = off (the historical Track-1 default).
#
# The platform calls predict() with a small, unknown N many times over (FINDINGS 49). Two
# things make compile safe here that were not true before (FINDINGS 148):
#
#   * COMPILE_DYNAMIC compiles ONE `dynamic=True` symbolic-shape graph that serves every N.
#     A static graph warmed at _BATCH would recompile inside a scored call when the real N
#     arrives (measured ~28.6 s) or need PAD_BATCHES, which is what actually cost -8.5
#     time_score twice (FINDINGS 49). `reduce-overhead` is NOT usable without padding: its
#     CUDA graphs raise on a second input shape.
#   * make_predict wraps the compile in try/except and sticky-demotes to eager on any
#     failure, so the worst case is the eager time this bundle would otherwise ship, never a
#     zeroed subscore.
#
# A reduced dtype under COMPILE changes the prediction at the fp16 quantum (max|d| ~5e-3),
# so any compiled bundle was re-scored locally before shipping.
# Estimate the operating point on the GPU instead of in numpy on the host
# (`models/op_estimate.py`). The window is uploaded either way, so the device twin runs on an
# array that is already resident and the transfer is not paid twice. It is the largest host-side
# item inside the timed region -- `runs/pipeline_profile/a10g.json` puts `infer_conditioning` at
# 0.188 ms/window of a 1.563 ms step, 12%, against 23% for ALL GPU work -- and host milliseconds
# are the expensive kind on the board's fitted time axis.
#
# `make_predict` refuses this at CONSTRUCTION for any configuration the twin does not implement
# (geometry/flow/mask planes, a non-freestream normalizer, a cond_mode other than
# operating_point, or a CPU device), so a bundle that should not use it cannot silently do so.
# The twin accumulates in float32 where the host accumulates in float64, deliberately: the
# faithful-dtype port is slower than what it replaces. That costs 9.7e-05 degrees of AoA and
# 4.2e-05% of Re at worst over 1166 real windows, against an estimator whose own held-out error
# is 1.15-1.77 degrees and 1.2%.
COND_DEVICE = {COND_DEVICE}
ZERO_P_DEVICE = {ZERO_P_DEVICE}

# corners3 Reynolds estimator (AoA-free, three freestream corners), baked in at package time like
# COND_DEVICE. Installing the override makes BOTH the host estimate_batch and the cond-device twin
# (models/op_estimate.py) serve corners3 in place of §122's u_fs Reynolds line.
RE_CORNERS = {RE_CORNERS}
if RE_CORNERS:
    from rpde_t1 import features as _features_c3  # noqa: E402

    _features_c3._re_override = _features_c3.corners3_reynolds

COMPILE_MODE = "{COMPILE_MODE}"
COMPILE_DYNAMIC = {COMPILE_DYNAMIC}

# Compiler-free CUDA-graph capture of the backbone, empty = off. A comma-separated bucket
# ladder ("1,2,4,...,210"); each scored call pads up to the smallest bucket >= N and the
# graph is replayed. torch.compile needs a C compiler the eval image lacks (Triton dies at
# make_launcher.py); CUDA graphs record the existing cuBLAS/cuDNN kernels and need none, so
# this runs in the image and is arch-correct because capture happens on the eval GPU at
# load. Captured under autocast at PRECISION; the fp32 non-finite recompute path stays eager
# (models/cudagraph.py). Mutually exclusive with COMPILE_MODE.
CUDAGRAPH_BUCKETS = "{CUDAGRAPH_BUCKETS}"

_state = {{"fn": None}}


def _get_predict():
    if _state["fn"] is None:
        device = "cuda" if torch.cuda.is_available() else "cpu"
        model, config = load_for_inference(_CKPT_PATH, kit_dir=_HERE, device=device)
        if RETURN_BOUNDS and not config.get("bounds", False):
            raise RuntimeError(
                "RETURN_BOUNDS is on but the checkpoint has no bound head; "
                "make_predict would fall back to a bare array and the platform "
                "would discard bounds for the whole run."
            )
        head = None
        head_tau = False
        if TKE_HEAD_NAME:
            from rpde_t1.models.tke_head import head_uses_tau, load_head

            head = load_head(os.path.join(_HERE, TKE_HEAD_NAME), device=device)
            # Read off the checkpoint, never guessed: `tke_features` always emits every plane,
            # so a head fitted WITH tau and one fitted with the plane zeroed share an input
            # width and cannot be told apart from the weights (FINDINGS 63m).
            head_tau = head_uses_tau(os.path.join(_HERE, TKE_HEAD_NAME))
        rule = None
        if WIDTH_RULE_NAME:
            from pathlib import Path

            from rpde_t1.models.width_rule import WidthRule

            # Loaded here, at construction: make_predict resamples a quantile-edged rule
            # onto a uniform grid, and that resample is 9.4 -> 3.5 ms/window inside the
            # region the platform times.
            rule = WidthRule.from_json(Path(_HERE) / WIDTH_RULE_NAME)
        anchor = None
        if LEAD_ANCHOR_NAME:
            from pathlib import Path

            from rpde_t1.models.lead_anchor import LeadAnchor

            anchor = LeadAnchor.from_json(Path(_HERE) / LEAD_ANCHOR_NAME)
        # make_predict calls torch.compile(model, mode=COMPILE_MODE) with no `dynamic`
        # argument. Inject it here, around that one construction, so the bundled rpde_t1/
        # stays byte-identical to the backbone's own source. make_predict already wraps the
        # compile in try/except and demotes to eager on failure, and sticky-demotes if a
        # compiled forward ever raises.
        mp_kwargs = dict(
            device=device,
            batch_size=_BATCH,
            return_bounds=RETURN_BOUNDS,
            bound_floor=BOUND_FLOOR,
            bound_scale=BOUND_SCALE,
            width_rule=rule,
            lead_anchor=anchor,
            normalizer=config.get("normalizer", "freestream"),
            cond_mode=config.get("cond_mode", "operating_point"),
            tke_blend=TKE_BLEND,
            tke_head=head,
            tke_shrink=TKE_SHRINK,
            tke_head_uses_tau=head_tau,
            geom_channels=GEOM_CHANNELS,
            flow_channels=FLOW_CHANNELS,
            precision=PRECISION,
            pad_batches=PAD_BATCHES,
            compile_mode=COMPILE_MODE or None,
            cond_device=COND_DEVICE,
            zero_p_device=ZERO_P_DEVICE,
            centre_shrink=CENTRE_SHRINK,
        )
        # Wrap the backbone in captured CUDA graphs before the closure is built. The probe
        # inside wrap_for_inference runs one make_predict forward to read the exact (x, cond)
        # the pipeline feeds the model, then captures the bucket ladder. Untimed at load.
        if CUDAGRAPH_BUCKETS:
            from rpde_t1.models.cudagraph import wrap_for_inference

            model = wrap_for_inference(
                model, CUDAGRAPH_BUCKETS, _BATCH, PRECISION, make_predict, mp_kwargs,
                device=device,
            )
        _compile = torch.compile
        if COMPILE_MODE and COMPILE_DYNAMIC:
            torch.compile = lambda m, **kw: _compile(m, **{{**kw, "dynamic": True}})
        try:
            _state["fn"] = make_predict(model, **mp_kwargs)
        finally:
            torch.compile = _compile
    return _state["fn"]


# Pay the construction and weight-loading cost at import, not inside predict().
#
# The signed-distance table is built here for the same reason, and it is not optional:
# the exact airfoil_sdf costs 52 ms per call and the head needs one per sample, which
# measured as -7.7 time_score -- ~800x the cost of the head's own forward pass. Building
# the 0.5-degree table takes ~4 s of the untimed load budget (a real submission used 1.9 s
# of 5 minutes) and makes each lookup 0.006 ms.
#
# The geometry input planes read the same table, so a `sdf` model needs it warmed for the
# same reason and at the same cost. Warming when it is not needed is wasted load time but
# never wrong, so the condition errs toward building it.
if TKE_HEAD_NAME or TKE_BLEND or GEOM_CHANNELS:
    warm_geometry_tables()

# One synthetic forward, here in the untimed region. The platform times predict() only, and
# the first forward is where cuDNN picks an algorithm per convolution, kernels are loaded to
# the device and the allocator grows its pool -- costs that otherwise land inside the first
# scored call. Runs at _BATCH because algorithm choice is per shape. Cannot raise.
# One synthetic forward at import, which the platform leaves untimed -- and that is measured,
# not assumed: `stf_sps_b210` carried this same warm-up and its board time was 5.20 ms/sample,
# i.e. pure steady state, where a charged import would have shown ~14. It moves the first
# forward's cuDNN algorithm choice, kernel loading and allocator growth out of the scored region.
# Cannot raise.
# reps=3 under compile: `default` reaches steady state on call 2, so a single rep leaves the
# compiled path's setup unpaid and it would land inside the first scored call. The return is
# CHECKED here: a False means the setup is still unpaid, so demote to eager, which is always
# correct and merely slower.
# Sizes to warm, NOT just _BATCH. cuDNN picks a convolution algorithm PER SHAPE and caches it,
# and the platform does not call predict() with N=_BATCH -- it uses a small N many times over
# (FINDINGS 49), so the one shape warmed here was a shape the board never asks for. Measured
# (FINDINGS 186): an unwarmed shape costs 0.074-0.092 s on its FIRST call, against 0.006 s at the
# warmed control, and warming this range removes it at every size for ~3.3 s of the construction
# budget. The platform's own N is not knowable from inside a submission without exporting a count
# of its calls, which the rules forbid -- warming a range makes knowing it unnecessary.
WARMUP_SIZES = {WARMUP_SIZES}

_warmed = True
for _size in WARMUP_SIZES:
    # `and` rather than a break: a single size failing to warm is not a reason to skip the rest,
    # and `_warmed` must end up False if ANY of them failed so the compile demotion below fires.
    # The clock-boost spin runs after the LAST size only: only that one can leave the card boosted
    # for the first scored call, and spinning after all nine cost 4.5 s of import (FINDINGS 189c).
    _spin = DEFAULT_SPIN_S if _size == WARMUP_SIZES[-1] else 0.0
    _warmed = (
        warm_up_predict(_get_predict(), _size, reps=3 if COMPILE_MODE else 1, spin_s=_spin)
        and _warmed
    )
if COMPILE_MODE and not _warmed:
    _fn = _get_predict()
    if hasattr(_fn, "demote_to_eager"):
        _fn.demote_to_eager()


def predict(input_array, metadata=None):
    """Track 1 API: (N, T_in, H, W, C) raw fields -> (N, T_out, H, W, C)."""
    x = np.asarray(input_array, dtype=np.float32)
    fn = _get_predict()
    # N=1 goes EAGER, always, under a dynamic compile. `dynamic=True` removes the per-shape
    # recompile for every batch size except one: Dynamo specialises size-1 dimensions
    # (broadcasting semantics differ at 1), so a batch of one compiles a SECOND graph --
    # measured in a daemonic worker at ~29.5 s/sample against ~56 ms eager, while every other
    # N (2/5/12/13/37/64/105/210) is clean. That single recompile would land inside a scored
    # call. Guarded rather than warmed: warming N=1 at import would pay the same ~29 s against
    # an already-tight construction budget to accelerate 1/210th of the score, and eager is
    # both correct and fast there.
    if (
        COMPILE_MODE
        and COMPILE_DYNAMIC
        and x.shape[0] == 1
        and hasattr(fn, "demote_to_eager")
    ):
        fn.demote_to_eager()
        try:
            out = fn(x, metadata)
        finally:
            fn.restore_compiled()
    else:
        out = fn(x, metadata)
    if RETURN_BOUNDS and not isinstance(out, dict):
        raise RuntimeError("bounds requested but predict returned a bare array")
    return out
