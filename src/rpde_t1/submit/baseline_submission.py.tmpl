"""RealPDE Track 1 submission: official {MODEL_NAME} baseline ({CKPT_NAME}).

GENERATED by `python -m rpde_t1.submit` -- do not edit in place; edit
src/rpde_t1/submit/baseline_submission.py.tmpl and rebuild.

Mirrors the benchmark evaluation pipeline (realpdebench eval.py): inputs are
z-scored with GaussianNormalizer statistics fitted on train_real, the network
runs in normalized space, and the prediction is mapped back to physical space
with the target statistics. Skipping this normalization is the single most common
reason a correctly-loaded baseline still scores badly.

Bounds: when RETURN_BOUNDS is on, a constant half-width band is emitted. On a
local eval set the SPS-optimal constant was ~1.5x the per-element error std;
BOUND_HALF_WIDTH below is that value. A per-element (heteroscedastic) band should
beat it -- coverage at the constant optimum is only ~0.90.
"""

from __future__ import annotations

import os
import sys

import numpy as np

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

import torch  # noqa: E402

from load_baseline import load_baseline  # noqa: E402  (prepends _vendor/ for einops)

_CKPT_PATH = os.path.join(_HERE, "{CKPT_NAME}")

# GaussianNormalizer statistics fitted on train_real 32x64 windows, channel order
# [u, v, p]; extracted from the benchmark's cached mean_std_real.pt. These are
# properties of the *data*, not of the model, so they are identical for
# CNO / FNO / Transolver. The p channel is unmeasured in real data (all zeros), so
# its stored std is 0 and is replaced by 1, exactly as GaussianNormalizer does.
_MEAN_IN = np.array([0.154960856, -0.000513992854, 0.0], dtype=np.float32)
_STD_IN = np.array([0.0968056545, 0.015960684, 1.0], dtype=np.float32)
_MEAN_TGT = np.array([0.154962569, -0.000517793698, 0.0], dtype=np.float32)
_STD_TGT = np.array([0.0968104079, 0.0159636438, 1.0], dtype=np.float32)

_BATCH = {BATCH}

# Emit lower/upper interval bounds for the SPS subscore.
RETURN_BOUNDS = {RETURN_BOUNDS}
BOUND_HALF_WIDTH = {BOUND_HALF_WIDTH}

_state = {{"model": None, "device": None}}


def _get_model():
    if _state["model"] is None:
        device = "cuda" if torch.cuda.is_available() else "cpu"
        model, _meta = load_baseline(_CKPT_PATH, device=device)
        model = model.to(device)
        model.eval()
        _state["model"] = model
        _state["device"] = device
    return _state["model"], _state["device"]


def predict(input_array, metadata=None):
    """Track 1 API: (N, T_in, H, W, C) raw fields -> (N, T_out, H, W, C)."""
    x = np.asarray(input_array, dtype=np.float32)
    model, device = _get_model()

    mean_in = torch.from_numpy(_MEAN_IN).to(device)
    std_in = torch.from_numpy(_STD_IN).to(device)
    mean_tgt = torch.from_numpy(_MEAN_TGT).to(device)
    std_tgt = torch.from_numpy(_STD_TGT).to(device)

    outs = []
    with torch.no_grad():
        for i in range(0, x.shape[0], _BATCH):
            xb = torch.from_numpy(np.ascontiguousarray(x[i : i + _BATCH])).to(device)
            xb = (xb - mean_in) / std_in
            yb = model(xb)
            yb = yb * std_tgt + mean_tgt
            outs.append(yb.float().cpu().numpy())

    prediction = np.concatenate(outs, axis=0).astype(np.float32)
    prediction[..., 2] = 0.0  # p is unmeasured in real data

    if not RETURN_BOUNDS:
        return prediction

    half = np.float32(BOUND_HALF_WIDTH)
    return {{
        "prediction": prediction,
        "lower": (prediction - half).astype(np.float32),
        "upper": (prediction + half).astype(np.float32),
    }}
