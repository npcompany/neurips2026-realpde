"""RealPDE Track 2 (LTTTA) submission: {RUN_NAME}.

GENERATED by `python -m rpde_t2.submit` -- do not edit in place; edit
src/rpde_t2/submit/ttt_submission.py.tmpl and rebuild.

A **zero-adaptation** entry: it runs the Track-1 inference path unchanged behind the
Track-2 streaming interface and returns ``adapt_loss=None`` on every step. That is the
point of it. The port and the modelling are separable, and shipping them separately means
the first board row measures exactly one thing -- whether a known artefact transfers --
instead of confounding that with an untested adaptation rule. Anything adaptive is judged
against this row, not against nothing.

The port is two affine maps, in `rpde_t2.to_physical` / `rpde_t2.to_normalized`. Track 1
hands `predict()` physical fields; Track 2 hands `ttt_step()` the same fields standardized
by the frozen official `train_real` statistics, and denormalizes what we return -- the
prediction and both SPS bounds alike -- with the *target* statistics. `rpde_t1.features`
already carries all four constants and they are bit-identical to the kit's
`example_data/mean_std_real.pt`.

Model construction, checkpoint loading and the warm-up happen at import, which Track 2
leaves untimed. Note the platform's 10-minute wall clock does include them.
"""

from __future__ import annotations

import os
import sys
import time
from typing import Any

# Wall clock of the whole import (model construction + warm-up), reported by the log line below.
_T_IMPORT = time.perf_counter()

# The evaluation platform runs each participant in a DAEMONIC subprocess, and a daemon may not
# spawn children. torch.compile's inductor otherwise starts a parallel-compile worker *pool*
# (AsyncCompile.warm_pool) at first use, which raises "daemonic processes are not allowed to
# have children" and kills the whole run at import. Forcing a single compile thread makes
# inductor compile synchronously in-process -- no pool, no child -- so compile works here.
# Set before torch is imported, because inductor reads it when its config module initialises.
# Forced (not setdefault): parallel compile only speeds the untimed warm-up, which we do not
# need, and a platform-set value > 1 would reintroduce the crash -- so 1 is always what we want.
os.environ["TORCHINDUCTOR_COMPILE_THREADS"] = "1"

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

import torch  # noqa: E402

# TF32 matmuls, FINDINGS 92's open item. The board A800 is sm_80, where an fp32 matmul can run
# on the tensor cores at a 10-bit mantissa, keeping fp32's 8-bit exponent and accumulating in
# fp32. PyTorch leaves `torch.backends.cuda.matmul.allow_tf32` False by default while
# `cudnn.allow_tf32` is already True, so every board row so far has run TF32 *convolutions* and
# non-TF32 *matmuls*; this switches the matmul half on as well. Must be set before
# torch.compile captures the graph, hence its position here rather than beside the other knobs.
#
# Accuracy risk was screened on the host path at fp16 -- the same 10-bit mantissa with a WORSE
# 5-bit exponent, so a strictly harsher perturbation. On this artefact the four accuracy axes
# moved at most 0.002 on val_extrap and hard5, i.e. under 0.002 board final. It is a hardware
# no-op below sm_80, so a T4 build is bit-identical to a plain one and only the board can
# measure either half.
if {TF32}:
    torch.set_float32_matmul_precision("high")

from rpde_t1.features import REAL_MEAN_TARGET, REAL_STD_TARGET  # noqa: E402
from rpde_t1.geometry import parse_geom_channels, warm_geometry_tables  # noqa: E402
from rpde_t1.models.factory import load_for_inference  # noqa: E402
from rpde_t1.models.factory import stream_state_frames  # noqa: E402
from rpde_t1.models.predictor import make_gpu_predict, make_predict, warm_up_predict  # noqa: E402
from rpde_t2 import EXPECTED_SHAPE  # noqa: E402
from rpde_t2.ttt import FrozenPort, TrajectoryCalibratedPort  # noqa: E402

_CKPT_PATH = os.path.join(_HERE, "{CKPT_NAME}")

# The device the model actually runs on, decided here rather than taken from
# get_ttt_model's argument. Two reasons: _get_predict already resolves it this way, so a
# second source of truth could disagree with itself; and the starting kit's local_eval.py
# hardcodes device="cpu" while the platform passes "cuda", which would mean the bundle
# exercised a different code path locally than on the board -- exactly the class of
# discrepancy that has cost us time_score before.
_DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

# Track 2 streams one window per call, so there is no batch axis to fill and nothing to pad
# to. Both differ from the Track-1 bundle (210 / True) and neither is inheritable:
# `pad_batches` repeats the last sample up to `_BATCH`, which at 210 would multiply every
# timed step's compute by 210.
_BATCH = 1
PAD_BATCHES = False

# `torch.compile` was absent on the Track-1 bundles because it was 2-for-2 against us there
# (local 85.1 -> board 80.6, 92.4 -> board 83.6) -- but that is the batch-210 regime, where the
# forward is already amortised and the tail's variable shape forced a recompile inside the timed
# region. Track 2 is the opposite regime: batch 1, ONE fixed input shape every scored step, so
# CUDA-graph capture happens once (in the untimed warm-up) and never re-triggers. Measured on the
# 294-step val_extrap stream, `reduce-overhead` cut the step 11.2 -> 7.3 ms (time_score 88.97 ->
# 90.91) with all five subscores bit-identical. The forward alone falls 6.71 -> 2.53 ms: at
# batch 1 the step is launch-overhead bound, exactly what CUDA graphs remove. make_predict makes
# the compiled path STICKY-demote-to-eager on any error, so the downside is bounded at the eager
# time and a compile failure on the eval box cannot zero a subscore.
COMPILE_MODE = "{COMPILE_MODE}"
# GPU-native tail (FINDINGS 76b): keep the input on the device and run bridge -> freestream ->
# normalise -> forward -> denorm -> anchor -> width rule -> guard -> out_transform as ONE
# compiled graph, so the batch-1 step is not sync-bound. Only valid for the frozen bounds
# configuration (no TKE head, no calibration); falls back to the standard host path otherwise.
GPU_NATIVE = {GPU_NATIVE}
# Per-trajectory MEAN-FLOW bias inside the GPU-native path (FINDINGS 77): the one adaptation
# that STACKS on drop-path. The signed residual (revealed target - prediction) averaged over
# leads is this trajectory's first-moment error, added as a constant temporal shift -- pure
# mvpe/rel_l2, tke untouched. 0 disables it. Runs on-device, so the fast step keeps its time.
MEAN_BIAS_STRENGTH = {MEAN_BIAS_STRENGTH}

RETURN_BOUNDS = {RETURN_BOUNDS}


def _wants_gpu_native():
    """The single definition of "use the compiled GPU-native path".

    Two call sites need this answer and they must never disagree: _get_predict picks the
    closure, get_ttt_model tells FrozenPort which calling contract to expect. A function
    rather than two copies of the expression, because the copies drifted once already.
    """
    return bool(GPU_NATIVE and COMPILE_MODE and RETURN_BOUNDS and not _CALIBRATING)
BOUND_FLOOR = {BOUND_FLOOR}
BOUND_SCALE = {BOUND_SCALE}
WIDTH_RULE_NAME = "{WIDTH_RULE_NAME}"
LEAD_ANCHOR_NAME = "{LEAD_ANCHOR_NAME}"
TKE_HEAD_NAME = "{TKE_HEAD_NAME}"
TKE_BLEND = {TKE_BLEND}
TKE_SHRINK = {TKE_SHRINK}
PRECISION = "{PRECISION}"
GEOM_CHANNELS = parse_geom_channels("{GEOM_CHANNELS}")

# Per-trajectory calibration from revealed history: 0.0 for both is the frozen control.
# See rpde_t2.ttt.TrajectoryCalibratedPort -- the measurements say the exploitable structure
# is a per-trajectory constant (r=0.60), not a per-step update (r=0.013), so this is
# closed-form and needs no gradients.
GAIN_STRENGTH = {GAIN_STRENGTH}
BIAS_STRENGTH = {BIAS_STRENGTH}
# "meanflow": the additive bias is the residual averaged over the lead axis -- a pure
# first-moment (mvpe/rel_l2) correction that leaves tke untouched, so it STACKS on the drop-path
# tke lever. "perframe" is the old per-lead residual, which moves tke (and hurts it).
BIAS_MODE = "{BIAS_MODE}"
# Shrinkage grows with the history: lam_k = strength * n / (n + WARMUP_N0). The only variant
# that beat a constant schedule across six estimator families, and it beat it on both splits.
WARMUP_N0 = {WARMUP_N0}
BIAS_FREEZE_N = {BIAS_FREEZE_N}
MEAN_BIAS_SMOOTH = {MEAN_BIAS_SMOOTH}

# How the absent earlier frames are filled on the FIRST window of each trajectory, when the
# backbone reads more than the 20 frames the stream hands out per step. Inert at t_in == 20.
# The stream genuinely has no history there (the contract passes prev_target_norm=None), so
# this is a real train/serve question, not a formality -- see rpde_t2.ttt._with_history.
HISTORY_FILL = "{HISTORY_FILL}"
STATE_FREEZE_N = {STATE_FREEZE_N}
# The newer causal module (models/causal_history_v2.py) and its two extra mechanisms: the
# measurement-noise gain floor and the rho-adaptive conformal interval. All default off, so a
# bundle that passes none of them runs the module every recorded board row ran.
CAUSAL_V2 = {CAUSAL_V2}
CAUSAL_GAIN_FLOOR = {CAUSAL_GAIN_FLOOR}
INTERVAL_RHO_BLEND = {INTERVAL_RHO_BLEND}
INTERVAL_RHO_RAMP_N0 = {INTERVAL_RHO_RAMP_N0}
INTERVAL_RHO_SHAPE = {INTERVAL_RHO_SHAPE}
# Self-calibrating intervals (FINDINGS 192, models/interval_autocal.py): per-trajectory width
# multipliers picked by the SPS credit the revealed windows would have earned. 0 = off.
INTERVAL_AUTOCAL_N0S = {INTERVAL_AUTOCAL_N0S}
INTERVAL_AUTOCAL_N0P = {INTERVAL_AUTOCAL_N0P}
INTERVAL_AUTOCAL_STAGE1 = "{INTERVAL_AUTOCAL_STAGE1}"
INTERVAL_AUTOCAL_SHIFT = {INTERVAL_AUTOCAL_SHIFT}
INTERVAL_AUTOCAL_GRID = {INTERVAL_AUTOCAL_GRID}
INTERVAL_AUTOCAL_LEAD_SUB = {INTERVAL_AUTOCAL_LEAD_SUB}
INTERVAL_AUTOCAL_FREEZE_N = {INTERVAL_AUTOCAL_FREEZE_N}
# Pinned host staging for the batch-1 input and outputs (FINDINGS 194): same values, fewer
# synchronous driver-side copies.
PINNED_IO = {PINNED_IO}
# Learned interval calibrator (models/interval_recal.py): a per-pixel width multiplier folded
# from the revealed errors of the stream. Bundled under this name when requested; "" = off.
INTERVAL_RECAL_NAME = "{INTERVAL_RECAL_NAME}"
# Its jiterator-fused serving step (FINDINGS 208): same widths within one fp16 ulp, fewer kernels.
INTERVAL_RECAL_FUSED = {INTERVAL_RECAL_FUSED}
# Its observe + apply captured INSIDE the one pipeline graph (2026-09-25 night): no second graph
# launch, and the fast path's static-input copy and in-graph finiteness flag stay on. FORK runs
# the observe as a branch parallel to the backbone inside that graph.
INTERVAL_RECAL_MERGED = {INTERVAL_RECAL_MERGED}
INTERVAL_RECAL_FORK = {INTERVAL_RECAL_FORK}
# Port warm-up (FINDINGS 222c/222d): the import-time warm-up above only exercises the predict
# closure, never the streaming path `FrozenPort.ttt_step` uses, so without this the FIRST scored
# step paid the stream path's one-time build (fast-path identity check + CUDA-graph capture,
# ~95 ms). `get_ttt_model` therefore drives a few SYNTHETIC trajectories through the port in the
# untimed region and resets it afterwards. 0 = off, 1 = one trajectory of 3 steps (222c),
# 2 = two trajectories of 40 + 12 steps (the `_pw2` variant, 0.19 s untimed). Outputs on the
# real stream are bit-identical with and without it (measured, 222c).
PORT_WARMUP = {PORT_WARMUP}
# Log lines on stderr, prefixed `[t2]`: pid and load time at import, the port warm-up, every
# reset and every step (shape, dtype, our own milliseconds). The organizers return the
# ingestion log, which is how the board's own timing of the last Track-1 row was read.
# Never raises: every write is wrapped. Costs one formatted write per timed step.
STEP_LOG = {STEP_LOG}

# The evaluator's coordinate change, done on the device inside the predictor just before its
# one copy to host, instead of on the host afterwards. The wrapper's three full-array numpy
# maps cost 1.913 ms/step at batch 1 and the on-device round trip that replaced them 1.125;
# folding the same affine into the copy that has to happen anyway costs nothing and removes
# both. `out_dtype` then halves that copy again -- the harness re-casts on write, so no
# subscore moves -- and it is deliberately NOT `precision`, because on the EAGER host path
# fp16 *compute* at batch 1 costs 1.1 ms more in cast kernels than it saves. (On the compiled
# GPU-native path that trade reverses -- the casts fuse into the graph -- which is what the
# PRECISION knob now controls there.)
#
# Both ports take the map: the calibration commutes with it (see TrajectoryCalibratedPort), so
# it accumulates its statistics in evaluator space against `prev_target_norm` as delivered.
# The fp16 half is the frozen port's only, because the calibration does its arithmetic in
# numpy on the returned buffer and a half-width accumulator would quantise the prediction
# itself rather than just the wire format.
_PREMAP = True
_CALIBRATING = bool(GAIN_STRENGTH or BIAS_STRENGTH)
_OUT_TRANSFORM = (1.0 / REAL_STD_TARGET, -REAL_MEAN_TARGET / REAL_STD_TARGET)

_state: dict[str, Any] = {{"fn": None, "t_in": 20, "stream_state": ""}}


def _get_predict():
    if _state["fn"] is None:
        device = _DEVICE
        model, config = load_for_inference(_CKPT_PATH, kit_dir=_HERE, device=device)
        # Read from the checkpoint rather than passed in at packaging: a long-context bundle
        # then cannot be served with the wrong window length, which is silent (the stem simply
        # sees fewer columns than it was trained with) rather than an error.
        _state["t_in"] = int(config.get("t_in", 20))
        # Same rule as t_in: read off the checkpoint so a stream-state bundle cannot be served
        # without its trajectory-state pseudo-frames (which would be silent, not an error --
        # the widened stem simply reads zeros where the state belongs).
        _state["stream_state"] = str(config.get("stream_state") or "")
        if RETURN_BOUNDS and not config.get("bounds", False):
            raise RuntimeError(
                "RETURN_BOUNDS is on but the checkpoint has no bound head. Track 2 requires "
                "bounds on every step or none, so falling back to a bare array mid-run "
                "would fail the whole run at ingestion rather than merely lose SPS."
            )
        head, head_tau = None, False
        if TKE_HEAD_NAME:
            from rpde_t1.models.tke_head import head_uses_tau, load_head

            _head_path = os.path.join(_HERE, TKE_HEAD_NAME)
            head = load_head(_head_path, device=device)
            # Must match how the head was FITTED. Read off the checkpoint rather than assumed:
            # a mismatch is silent (the input width is identical either way) and worth up to
            # 0.31 in the log ratio. The Track-1 template has always done this; this one did
            # not, so a tau-fitted head was served a zeroed tau plane.
            head_tau = head_uses_tau(_head_path)
        rule = None
        if WIDTH_RULE_NAME:
            from pathlib import Path

            from rpde_t1.models.width_rule import WidthRule

            # Loaded at construction: make_predict resamples a quantile-edged rule onto a
            # uniform grid, and on Track 1 that resample measured 9.4 -> 3.5 ms/window
            # inside the timed region.
            rule = WidthRule.from_json(Path(_HERE) / WIDTH_RULE_NAME)
        anchor = None
        if LEAD_ANCHOR_NAME:
            from pathlib import Path

            from rpde_t1.models.lead_anchor import LeadAnchor

            anchor = LeadAnchor.from_json(Path(_HERE) / LEAD_ANCHOR_NAME)
        # MUST stay identical to the `_gpu_native` expression in get_ttt_model below: the port
        # is told which contract to use, and this decides which closure it gets. When they
        # disagreed, a head-carrying bundle handed an evaluator-space device tensor to the host
        # closure, which calls np.asarray on it.
        if _wants_gpu_native():
            _state["fn"] = make_gpu_predict(
                model,
                device=device,
                width_rule=rule,
                lead_anchor=anchor,
                cond_mode=config.get("cond_mode", "operating_point"),
                compile_mode=COMPILE_MODE,
                mean_bias_strength=MEAN_BIAS_STRENGTH,
                bias_freeze_n=BIAS_FREEZE_N,
                mean_bias_smooth=MEAN_BIAS_SMOOTH,
                causal_gain_strength={CAUSAL_GAIN_STRENGTH},
                interval_history_spatial={INTERVAL_HISTORY_SPATIAL},
                interval_history_global={INTERVAL_HISTORY_GLOBAL},
                causal_anom={CAUSAL_ANOM},
                tke_head=head,
                tke_blend=TKE_BLEND,
                tke_shrink=TKE_SHRINK,
                tke_head_uses_tau=head_tau,
                stream_state=_state["stream_state"],
                state_freeze_n=STATE_FREEZE_N,
                causal_v2=CAUSAL_V2,
                causal_gain_floor=CAUSAL_GAIN_FLOOR,
                interval_rho_blend=INTERVAL_RHO_BLEND,
                interval_rho_ramp_n0=INTERVAL_RHO_RAMP_N0,
                interval_rho_shape=INTERVAL_RHO_SHAPE,
                interval_autocal_n0s=INTERVAL_AUTOCAL_N0S,
                interval_autocal_n0p=INTERVAL_AUTOCAL_N0P,
                interval_autocal_stage1=INTERVAL_AUTOCAL_STAGE1,
                interval_autocal_shift=INTERVAL_AUTOCAL_SHIFT,
                interval_autocal_grid=INTERVAL_AUTOCAL_GRID,
                interval_autocal_lead_sub=INTERVAL_AUTOCAL_LEAD_SUB,
                interval_autocal_freeze_n=INTERVAL_AUTOCAL_FREEZE_N,
                pinned_io=PINNED_IO,
                interval_recal=os.path.join(_HERE, INTERVAL_RECAL_NAME) if INTERVAL_RECAL_NAME else "",
                interval_recal_fused=INTERVAL_RECAL_FUSED,
                interval_recal_merged=INTERVAL_RECAL_MERGED,
                interval_recal_fork=INTERVAL_RECAL_FORK,
                # fp16 here means autocast INSIDE the one compiled graph. The batch-1 step is
                # compute-bound, not launch-bound, once CUDA graphs remove the launches, and
                # fp16 cut the compiled forward 4.40 -> 1.69 ms on the local T4 with every
                # accuracy axis moving under the 0.01 screen bar. Guarded: every fp16 step is
                # finiteness-checked on the device and sticky-demotes to eager fp32.
                precision=PRECISION,
            )
            return _state["fn"]
        _state["fn"] = make_predict(
            model,
            device=device,
            batch_size=_BATCH,
            return_bounds=RETURN_BOUNDS,
            bound_floor=BOUND_FLOOR,
            bound_scale=BOUND_SCALE,
            width_rule=rule,
            lead_anchor=anchor,
            normalizer=config.get("normalizer", "freestream"),
            cond_mode=config.get("cond_mode", "operating_point"),
            tke_blend=TKE_BLEND,
            tke_head=head,
            tke_shrink=TKE_SHRINK,
            tke_head_uses_tau=head_tau,
            # The planes the checkpoint was trained with, read off its config as `cond_mode`
            # and `normalizer` are; the render-time field stays as an override. Without this a
            # `--geom-channels` model was served 20 fewer input channels (unet2d, 2026-09-18).
            state_frames=stream_state_frames(_state["stream_state"]),
            geom_channels=GEOM_CHANNELS or parse_geom_channels(config.get("geom_channels", "")),
            precision=PRECISION,
            pad_batches=PAD_BATCHES,
            out_transform=_OUT_TRANSFORM,
            out_dtype=None if _CALIBRATING else "fp16",
            compile_mode=COMPILE_MODE or None,
        )
    return _state["fn"]


if TKE_HEAD_NAME or TKE_BLEND or GEOM_CHANNELS:
    warm_geometry_tables()

# One synthetic forward in the untimed region, at _BATCH because cuDNN picks its algorithms
# per shape -- and _BATCH is now the shape every scored step actually uses. Cannot raise.
# reduce-overhead captures a CUDA graph on the first few calls, so warm it more than the
# single eager rep -- all in the untimed import region, so the extra reps cost nothing scored.
_WARM_OK = warm_up_predict(
    _get_predict(),
    _BATCH,
    reps=5 if COMPILE_MODE else 1,
    # The gpu-native closure takes the WIRE window and builds its own state; the host path
    # takes the model-width input, state pseudo-frames included.
    t_in=_state["t_in"]
    + (0 if _wants_gpu_native() else stream_state_frames(_state["stream_state"])),
)


def _log(msg: str) -> None:
    """One `[t2]` line on stderr; logging can never fail or slow a run beyond one write."""
    if not STEP_LOG:
        return
    try:
        sys.stderr.write("[t2] " + msg + "\n")
        sys.stderr.flush()
    except Exception:  # noqa: BLE001 - logging must never fail a run
        pass


def _serving_state() -> str:
    """The predict closure's serving state (graph captured? fast path on?), for the log only."""
    try:
        fn = _state["fn"]
        cells = dict(zip(fn.__code__.co_freevars, fn.__closure__ or (), strict=False))

        def get(n):
            try:
                v = cells[n].cell_contents if n in cells else None
            except ValueError:
                v = None
            return v if isinstance(v, dict) else None

        cg, fs, use = get("_cg"), get("_fsw"), get("_use")
        graph = None if cg is None else (cg.get("g") is not None)
        graph_on = None if cg is None else cg.get("on")
        fast = None if fs is None else (fs.get("on") and fs.get("checked"))
        compiled = None if use is None else use.get("compiled")
        return "graph=%s graph_on=%s fast=%s compiled=%s" % (graph, graph_on, fast, compiled)
    except Exception:  # noqa: BLE001 - informational only
        return "graph=? graph_on=? fast=? compiled=?"


_log("pid=%d load_s=%.2f warm_ok=%s" % (os.getpid(), time.perf_counter() - _T_IMPORT, _WARM_OK))


def _warm_port(port) -> None:
    """Untimed synthetic trajectories through the port itself, then a reset (FINDINGS 222c)."""
    lengths = (3,) if PORT_WARMUP == 1 else (40, 12)
    gen = torch.Generator().manual_seed(1234)
    t0 = time.perf_counter()
    n = 0
    try:
        for length in lengths:
            port.reset_ttt_state()
            prev = None
            for _ in range(length):
                x = torch.randn(EXPECTED_SHAPE, generator=gen) * 0.5
                port.ttt_step(x, prev)
                prev = x
                n += 1
    except Exception:  # noqa: BLE001 - a failed warm-up costs time, never the run
        pass
    finally:
        try:
            port.reset_ttt_state()
        except Exception:  # noqa: BLE001
            pass
    _log("port_warmup steps=%d s=%.2f %s" % (n, time.perf_counter() - t0, _serving_state()))


class _LoggedPort:
    """The port with `[t2]` lines: one per reset, the first three steps of every trajectory in
    full, and one summary line per trajectory (count, mean, min, max, steps over 20 ms) when
    the next reset comes or the process exits. Numerics untouched.

    The board's ingestion shows only the first 10240 bytes of stderr (FINDINGS 232); a line
    per step overran that at the third trajectory, so the per-step lines stop after three."""

    LOGGED_STEPS = 3
    SLOW_MS = 20.0

    def __init__(self, port) -> None:
        self._port = port
        self._traj = 0
        self._step = 0
        self._first = True
        self._sum = 0.0
        self._max = 0.0
        self._min = float("inf")
        self._slow = 0
        try:
            import atexit

            atexit.register(self._summary)
        except Exception:  # noqa: BLE001 - the summary is informational
            pass

    def _summary(self) -> None:
        if self._step == 0:
            return
        _log(
            "traj_done traj=%d steps=%d mean_ms=%.3f min_ms=%.2f max_ms=%.2f slow20=%d"
            % (self._traj, self._step, self._sum / self._step, self._min, self._max, self._slow)
        )
        self._step = 0
        self._sum, self._max, self._min, self._slow = 0.0, 0.0, float("inf"), 0

    def reset_ttt_state(self) -> None:
        t0 = time.perf_counter()
        self._port.reset_ttt_state()
        ms = (time.perf_counter() - t0) * 1e3
        self._summary()
        self._traj += 1
        _log("reset traj=%d ms=%.2f" % (self._traj, ms))

    def ttt_step(self, input_norm, prev_target_norm=None):
        t0 = time.perf_counter()
        out = self._port.ttt_step(input_norm, prev_target_norm)
        ms = (time.perf_counter() - t0) * 1e3
        self._step += 1
        self._sum += ms
        if ms > self._max:
            self._max = ms
        if ms < self._min:
            self._min = ms
        if ms > self.SLOW_MS:
            self._slow += 1
        if self._step > self.LOGGED_STEPS:
            return out
        try:
            line = "step traj=%d i=%d shape=%s dtype=%s device=%s prev=%s ms=%.2f" % (
                self._traj,
                self._step,
                str(tuple(input_norm.shape)).replace(" ", ""),
                str(input_norm.dtype).replace("torch.", ""),
                getattr(input_norm, "device", "?"),
                "none" if prev_target_norm is None else "given",
                ms,
            )
            if self._first:
                self._first = False
                line += " " + _serving_state()
            _log(line)
        except Exception:  # noqa: BLE001 - logging must never fail a run
            pass
        return out


def get_ttt_model(submission_dir: str, device: str):
    """Track-2 entry point, called once before the stream. Not timed."""
    port = _build_port()
    if PORT_WARMUP:
        _warm_port(port)
    if STEP_LOG:
        port = _LoggedPort(port)
    return port


def _build_port():
    if GAIN_STRENGTH or BIAS_STRENGTH:
        return TrajectoryCalibratedPort(
            _get_predict(),
            GAIN_STRENGTH,
            BIAS_STRENGTH,
            device=_DEVICE,
            warmup_n0=WARMUP_N0,
            premapped=_PREMAP,
            bias_mode=BIAS_MODE,
            t_in=_state["t_in"],
            history_fill=HISTORY_FILL,
            state_mode=_state["stream_state"],
            state_freeze_n=STATE_FREEZE_N,
        )
    _gpu_native = _wants_gpu_native()
    return FrozenPort(
        _get_predict(),
        device=_DEVICE,
        premapped=_PREMAP,
        gpu_native=_gpu_native,
        t_in=_state["t_in"],
        history_fill=HISTORY_FILL,
        state_mode=_state["stream_state"],
        state_freeze_n=STATE_FREEZE_N,
    )
